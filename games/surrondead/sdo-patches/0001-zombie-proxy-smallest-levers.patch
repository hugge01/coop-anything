+// Opt-in zombie proxy rendering. Default OFF — matches upstream disable after
+// the 2026-08-14 crash saga. Enable with empty file
+// %APPDATA%\SDO\enable_zombie_proxies.flag or env SDO_ENABLE_ZOMBIE_PROXIES=1
+// (file form preferred; Steam-inherited env is unreliable — see mod.cpp
+// env_flag_set commentary). Cap concurrent zombie actors to limit flood cost.
+static bool zombie_proxies_enabled()
+{
+    static const bool s_on = [] {
+        wchar_t buf[8];
+        const DWORD n = GetEnvironmentVariableW(L"SDO_ENABLE_ZOMBIE_PROXIES", buf, 8);
+        if (n > 0 && n < 8 && buf[0] == L'1') {
+            debug_log("zombie_proxies: ENABLED via SDO_ENABLE_ZOMBIE_PROXIES=1");
+            return true;
+        }
+        wchar_t path[MAX_PATH];
+        const DWORD a = GetEnvironmentVariableW(L"APPDATA", path, MAX_PATH);
+        if (a == 0 || a >= MAX_PATH) return false;
+        const std::wstring flag = std::wstring(path, a) + L"\\SDO\\enable_zombie_proxies.flag";
+        const bool on = GetFileAttributesW(flag.c_str()) != INVALID_FILE_ATTRIBUTES;
+        if (on) debug_log("zombie_proxies: ENABLED via enable_zombie_proxies.flag");
+        return on;
+    }();
+    return s_on;
+}
+
