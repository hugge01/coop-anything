     groups[parent], groups_parent[parent] = set, parent_too == true
 end
+-- hugge01: callers (vehicles.scan) can pick up child classes learned after a game update
+function util.group_members(parent)
+    return groups[parent]
+end
 local function not_cdo(o)
     local cdo = false
     pcall(function() cdo = o:GetFullName():find("Default__", 1, true) ~= nil end)
@@ -651,7 +655,18 @@ function util.instances(cls, hooks, group)
         end
         local grp = t.group and not groups_solo[t.group] and t.group
         local g = grp and group_walk(grp)
-        if g and g.unknown then
+        -- hugge01/v1.1.0 patch: absorb unknown children into the group instead of forever
+        -- falling back to one FindAllOf per class (join hitch; Humvee2 lesson). Attribution:
+        -- SYMPLYSCK/SurrounSync — keep single parent walk after game updates add vehicle/AI types.
+        if g and g.unknown and groups[grp] then
+            for c in pairs(g.buckets) do
+                if c ~= grp and not groups[grp][c] then
+                    groups[grp][c] = true
+                    log.info("instances: " .. grp .. " learned child " .. c .. " - kept one group walk")
+                end
+            end
+            g.unknown = nil
+        elseif g and g.unknown then
